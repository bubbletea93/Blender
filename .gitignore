# Blender backup and recovery files
*.blend[0-9]
*.blend[0-9][0-9]
quit.blend
quit.blend[0-9]

# Blender caches and generated data
blendcache_*/
cache/
renders/*
!renders/gel_polish_angles/
renders/gel_polish_angles/*
!renders/gel_polish_angles/*.png

# Required collider source; keep generated Shot 3 caches and reviews ignored.
!renders/shot3_liquigen_review/
renders/shot3_liquigen_review/*
!renders/shot3_liquigen_review/inputs/
renders/shot3_liquigen_review/inputs/*
!renders/shot3_liquigen_review/inputs/shot3_proxy_clearance_v010.fbx

# General temporary files
*.tmp
*.temp
*.bak
*.log

# Python caches for project scripts
__pycache__/
*.py[cod]

# Extracted video frames and reference shot clips (large binary assets)
references/lapohka_3d_motion_frames/
references/lapohka_3d_motion_shots/

# Editor and OS files
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini
